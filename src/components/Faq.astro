---
import data from '../data/site.json';
const pairs = data.faq as [string, string][];
---
<section class="section questions">
  <div class="wrap local-grid">
    <div>
      <div class="eyebrow">Before we begin</div>
      <h2>A few good<br />questions.</h2>
      <p>Useful answers for the first steps of your project.</p>
    </div>
    <div>
      {pairs.map(([q, a]) => (
        <details><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </div>
</section>
