# Mirror of the headers in vercel.json (Vercel ignores this file).
#
# The googletagmanager.com / google-analytics.com / gstatic.com sources are
# Google's published list for Tag Manager, GA4 without Ads features, and GTM
# Preview mode. They are used only after a visitor accepts analytics cookies
# (public/consent.js). Anyone with Publish rights on the GTM container can run
# script on every page of this site. Do not add 'unsafe-eval'.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://ssl.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://tagmanager.google.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' https://www.googletagmanager.com https://tagmanager.google.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; upgrade-insecure-requests
