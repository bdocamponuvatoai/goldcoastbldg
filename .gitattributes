# Normalise to LF in the repository and on checkout. build.py writes its
# output with newline='\n', so pinning the sources to LF keeps the build
# byte-identical between a Windows workstation and Linux CI.
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

# never touch binaries
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary
